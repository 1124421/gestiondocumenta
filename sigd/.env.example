# ============================================================
# SIGD — Variables de Entorno
# Copiar este archivo como .env y completar cada valor.
# NUNCA subir el .env real al repositorio.
# ============================================================

# ── BASE DE DATOS ────────────────────────────────────────────
# Cadena de conexión a PostgreSQL para Prisma ORM
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/sigd_db"

# ── AUTENTICACIÓN ────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET="tu_clave_secreta_super_segura_aqui"
# Tiempo de expiración del token de acceso (ej: 15m, 1h, 7d)
JWT_EXPIRES_IN="15m"
# Tiempo de expiración del refresh token
JWT_REFRESH_EXPIRES_IN="7d"

# ── REDIS ────────────────────────────────────────────────────
# URL de conexión a Redis (usado para caché, sesiones y colas)
REDIS_URL="redis://localhost:6379"

# ── ALMACENAMIENTO (MinIO / S3) ───────────────────────────────
# Endpoint del servidor MinIO (almacenamiento de archivos)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
# Nombre del bucket donde se guardarán los documentos
MINIO_BUCKET_NAME="sigd-documentos"

# ── ELASTICSEARCH ────────────────────────────────────────────
# URL del motor de búsqueda (para búsqueda semántica avanzada)
ELASTICSEARCH_URL="http://localhost:9200"

# ── INTELIGENCIA ARTIFICIAL ──────────────────────────────────
# API Key de OpenAI (para clasificación, resumen y asistente IA)
OPENAI_API_KEY="sk-..."
# Modelo de OpenAI a usar (ej: gpt-4o, gpt-4-turbo)
OPENAI_MODEL="gpt-4o"

# ── OCR ──────────────────────────────────────────────────────
# Proveedor de OCR: "tesseract" | "azure" | "google"
OCR_PROVIDER="tesseract"
# (Opcional) Carpeta con spa.traineddata.gz y eng.traineddata.gz para OCR sin internet
OCR_LANG_PATH=""
# Solo si usas Azure Document Intelligence:
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""

# ── NOTIFICACIONES ───────────────────────────────────────────
# Configuración de correo electrónico para enviar alertas
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="correo@empresa.com"
SMTP_PASS="contraseña_correo"
EMAIL_FROM="noreply@empresa.com"

# ── APLICACIÓN ───────────────────────────────────────────────
# Entorno de ejecución: development | production | test
NODE_ENV="development"
# Puerto en que corre el backend
BACKEND_PORT=3001
# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:3000"
